# Pengaturan aplikasi Notis. SALIN berkas ini menjadi "memori.env" (di folder yang sama), lalu ubah nilainya.
# Berkas memori.env tidak ikut git. Variabel lingkungan sungguhan (mis. $env:MEMORI_ROUTER di PowerShell) selalu mengalahkan berkas ini.
# Mulai ulang aplikasi setelah mengubah berkas ini.

# Pemilih alat (classifier):
#   off    = perilaku lama, classifier tidak dipakai (bawaan)
#   shadow = classifier jalan paralel hanya untuk mencatat; jawaban tidak berubah
#   on     = classifier ikut menentukan alat (masih opsional; lihat README)
MEMORI_ROUTER=shadow

# Tempat mencatat log mode shadow (berkas lokal; kosongkan atau beri tanda # di depannya untuk tidak mencatat).
# MEMORI_ROUTER_LOG=data/memory/router_log.jsonl

# 1 = ikut simpan teks pesan di log itu agar bisa Anda beri label sendiri (hanya di komputer Anda, tidak dikirim ke mana pun).
# MEMORI_ROUTER_LOG_TEXT=1

# Seberapa yakin classifier harus sebelum bertindak (0 sampai 1; makin besar makin hati-hati). Bawaan 0.6.
# MEMORI_ROUTER_HINT_MIN_P=0.6
# MEMORI_ROUTER_REFUSE_MIN_P=0.6

# Pencarian hibrida BM25 + vektor (bawaan off). Butuh: pip install torch transformers (+ unduhan model sekali, ±470 MB).
# Bila model tidak bisa dimuat, aplikasi memakai BM25 saja. Lihat README.
# MEMORI_HYBRID=on
# MEMORI_EMBED_MODEL=intfloat/multilingual-e5-small
# Batas kemiripan vektor (0 sampai 1; bawaan 0.86). Makin kecil makin banyak hasil, makin besar risiko bagian dokumen tak relevan tampil.
# MEMORI_HYBRID_MIN_SIM=0.86
